# Security headers for Cloudflare Pages.
#
# IMPORTANT: Cloudflare applies EVERY matching rule, so a path matched by two
# rules that both set Content-Security-Policy receives two CSP headers — and
# browsers enforce the intersection of them. A blanket `/*` CSP would therefore
# silently override the claim app's script-src and stop app.js from loading.
#
# So: `/*` carries every header EXCEPT the CSP, and the CSP is set exactly once
# per path below.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Home page — runs one same-origin script, /assets/countdown.js, which ticks
# the cliff countdown and the vesting progress bar from hardcoded constants.
# script-src 'self' permits that file and nothing else: no inline script, no
# third-party script, and connect-src stays absent so the page cannot make a
# network request of any kind.
/
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src data:; font-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

/index.html
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src data:; font-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# DAO page — one same-origin script that reads your balance, voting power and
# delegate through your wallet, and can send exactly one transaction:
# delegate(address). connect-src stays absent; all RPC goes via the wallet.
/dao/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src data:; font-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Meme maker — draws to a canvas in the browser. It needs img-src 'self' for
# the cat, data: for pictures the visitor chooses (read via FileReader), and
# blob: for the rendered download. connect-src stays absent, so a picture
# physically cannot be sent anywhere: the page has no way to make a request.
/memes/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Trading leaderboard — generated nightly, also zero JavaScript. The numbers
# are computed at build time and baked into the HTML, so this page needs no
# script and no network access of its own.
/leaderboard/*
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src data:; font-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Claim app — needs JavaScript for wallet access. script-src 'self' permits only
# same-origin files (app.js) and still blocks every inline and third-party
# script. connect-src stays 'none': wallet calls go through the injected
# EIP-1193 provider, never through the page.
/claim/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src data:; font-src data:; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
